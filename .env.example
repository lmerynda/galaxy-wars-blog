DATABASE_URL=postgres://blog:local-blog-password@localhost:5548/galaxy_wars_blog
APP_URL=http://localhost:3000
# Calendar day assigned at first publication; saved entries keep their day.
BLOG_TIME_ZONE=America/Chicago
# Generate using npm run password:hash. No default owner password is shipped.
ADMIN_PASSWORD_HASH=''
# Optional AI publishing API. Generate 32 random bytes as hex; blank disables API access.
BLOG_API_TOKEN=''
S3_ENDPOINT=http://localhost:9018
S3_REGION=us-east-1
S3_BUCKET=galaxy-wars-blog
S3_ACCESS_KEY_ID=local-blog
S3_SECRET_ACCESS_KEY=local-blog-storage-password
S3_FORCE_PATH_STYLE=true
# Enable only on Railway's public edge (uses its X-Real-IP header).
TRUST_RAILWAY_PROXY=false
